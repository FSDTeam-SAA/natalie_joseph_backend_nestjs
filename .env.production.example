# Copy values into the VPS environment; never commit actual secrets.
NODE_ENV=production
PORT=8080
DATABASE_URL=
DATABASE_POOL_MAX=10
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
# Exact allowed HTTPS frontend origins, comma separated; no page paths.
CORS_ORIGINS=https://www.example.com
FRONTEND_URL=https://www.example.com
# 1 only when exactly one trusted reverse proxy is in front and port 8080 is private.
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=false
# Required HTTPS AI endpoint. Do not send bearer tokens over public HTTP.
AI_API_BASE_URL=https://ai.example.com/api/v1
AI_API_TIMEOUT_MS=60000
AI_API_LOG_TIMING=true
TELEGRAM_QUEUE_ENABLED=true
TELEGRAM_WORKER_CONCURRENCY=2
TELEGRAM_PUBLIC_BASE_URL=https://api.example.com
TELEGRAM_CONNECT_URL=https://www.example.com/login
TELEGRAM_REGISTER_URL=https://www.example.com/register
TELEGRAM_FORGOT_PASSWORD_URL=https://www.example.com/forgot-password
# Review Telegram Stars requirements before offering digital purchases inside Telegram.
TELEGRAM_CREDITS_URL=https://www.example.com/credits
TELEGRAM_SUBSCRIPTION_URL=https://www.example.com/subscriptions
# Also carry over bot IDs/usernames/tokens, webhook secret, Stripe, SMTP and media
# provider settings from your existing environment. See .env.telegram.example.
