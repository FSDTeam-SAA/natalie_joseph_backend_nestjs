model CreditCost {
  action    String   @id
  credits   Int
  updatedAt DateTime @updatedAt

  @@map("credit_costs")
}

model Relationship {
  id                String     @id @default(uuid())
  userId            String
  companionId       String
  nickname          String?
  notes             String?
  interactions      Int        @default(0)
  lastInteractionAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion         Companions @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([userId, companionId])
  @@map("relationships")
}

model StoryEvent {
  id          String     @id @default(uuid())
  companionId String
  day         DateTime   @db.Date
  title       String
  content     String
  published   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  companion   Companions @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([companionId, day])
  @@index([published, day])
  @@map("story_events")
}

model PhotoView {
  id            String     @id @default(uuid())
  userId        String
  companionId   String
  photoUrl      String
  creditCost    Int
  viewCount     Int        @default(1)
  firstViewedAt DateTime   @default(now())
  lastViewedAt  DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion     Companions @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([userId, companionId, photoUrl])
  @@index([userId, lastViewedAt])
  @@map("photo_views")
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  type        String
  title       String
  body        String
  referenceId String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model ConversationModeEvent {
  id             String           @id @default(uuid())
  conversationId String
  adminId        String
  mode           String
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_mode_events")
}
