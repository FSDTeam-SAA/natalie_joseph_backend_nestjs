# Merge into .env. Never commit real tokens. Restart the server after changes.
TELEGRAM_AUTO_REPLY_ENABLED=true
TELEGRAM_REPLY_MODE=ai
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=4
AI_API_LOG_TIMING=true
TELEGRAM_WEBHOOK_SECRET=
# Deployed backend origin only, no /api/v1 suffix.
TELEGRAM_PUBLIC_BASE_URL=
# Actual frontend page URLs (not backend payment endpoints).
TELEGRAM_CREDITS_URL=
TELEGRAM_SUBSCRIPTION_URL=
TELEGRAM_CONNECT_URL=
# HTTPS frontend pages. Missing values hide these Mini App links.
TELEGRAM_REGISTER_URL=
TELEGRAM_FORGOT_PASSWORD_URL=

TELEGRAM_ELENA_BOT_TOKEN=
TELEGRAM_ELENA_BOT_USERNAME=MeetElysiaOfficialElenaBot
TELEGRAM_ELENA_COMPANION_ID=
TELEGRAM_CHLOE_BOT_TOKEN=
TELEGRAM_CHLOE_BOT_USERNAME=MeetElysiaChloeBot
TELEGRAM_CHLOE_COMPANION_ID=
TELEGRAM_LINA_BOT_TOKEN=
TELEGRAM_LINA_BOT_USERNAME=MeetElysiaLinaBot
TELEGRAM_LINA_COMPANION_ID=
TELEGRAM_LUNA_BOT_TOKEN=
TELEGRAM_LUNA_BOT_USERNAME=
TELEGRAM_LUNA_COMPANION_ID=
TELEGRAM_THALIA_BOT_TOKEN=
TELEGRAM_THALIA_BOT_USERNAME=
TELEGRAM_THALIA_COMPANION_ID=
# Optional TELEGRAM_<NAME>_WEBHOOK_SECRET overrides the per-bot secret
# derived from TELEGRAM_WEBHOOK_SECRET. Setup script derives the same value.
